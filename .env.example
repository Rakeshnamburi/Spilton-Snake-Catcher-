# API — copy to services/api/.env for direct local execution.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://spilton:spilton@localhost:5432/spilton
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
WEB_ORIGINS=http://localhost:3000,http://localhost:8081
COOKIE_SECURE=false
DEMO_MODE=true
AUTHORIZED_OPERATION_ENABLED=false
PRICING_AUTHORIZED=false
PAYMENTS_ENABLED=false

# Private media and integrations
MEDIA_STORAGE_BACKEND=local
PRIVATE_MEDIA_DIR=./.private_media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
DEMO_EMAIL_RECIPIENT=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PROVIDER_URL=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_TEMPLATE_BOOKING=
PAYMENT_WEBHOOK_SECRET=
ERROR_MONITORING_DSN=

# Demo workflow configuration
DEFAULT_COMMISSION_PERCENT=10.00
BOOKING_RESPONSE_MINUTES=15
RESCUER_STALE_MINUTES=30
NOTIFICATION_MAX_ATTEMPTS=3
PUBLIC_WEB_URL=http://localhost:3000
TRACKING_SESSION_MINUTES=180
TRACKING_MIN_UPDATE_SECONDS=5
TRACKING_RETENTION_HOURS=24
ROUTING_PROVIDER_URL=
ROUTING_API_KEY=
ROUTING_CACHE_SECONDS=60
EVIDENCE_RETENTION_DAYS=30

# Clients
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
